# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real keys or account numbers.

# --- Korea Investment / broker API (to be decided) ---
# BROKER_APP_KEY=
# BROKER_APP_SECRET=
# BROKER_ACCOUNT_NO=

# --- US market data (example: Alpha Vantage) ---
# ALPHAVANTAGE_API_KEY=

# --- Notifications (example: Telegram) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Trading mode: paper (default) or live. Live also requires --live flag.
TRADING_MODE=paper
