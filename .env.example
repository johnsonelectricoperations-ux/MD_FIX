# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real keys or account numbers.

# --- Korea Investment & Securities (KIS Developers) ---
# Paper and live use DIFFERENT app keys; start with the paper ones.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01
# paper (default) or live. Live orders also require the --live flag.
KIS_MODE=paper

# --- Telegram notifications (docs/AWS_SETUP.md step 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
